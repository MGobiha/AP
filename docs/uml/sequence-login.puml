@startuml
actor Guest
participant "Login.jsp" as UI
participant LoginServlet
participant DAOFactory
participant UserDAO
participant DBConnection
database MySQL

Guest -> UI : enter username/password
UI -> LoginServlet : POST /login
LoginServlet -> LoginServlet : ValidationUtil checks blank fields
LoginServlet -> DAOFactory : getInstance()
DAOFactory -> UserDAO : createUserDAO()
LoginServlet -> UserDAO : login(username, password)
UserDAO -> DBConnection : getConnection()
DBConnection -> MySQL : SELECT users
MySQL --> UserDAO : row or empty
alt valid credentials
  UserDAO --> LoginServlet : Users object
  LoginServlet -> LoginServlet : store Users in HttpSession
  LoginServlet --> Guest : redirect by role
else invalid
  LoginServlet --> Guest : login.jsp?error=1
end
@enduml
